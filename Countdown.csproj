<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = aplicativo de janela (não abre console) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Countdown</AssemblyName>
    <RootNamespace>Countdown</RootNamespace>
    <!-- Manifesto com suporte a DPI por monitor (nitidez em telas com escala) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe (aparece no atalho, na barra de tarefas e no Explorer) -->
    <ApplicationIcon>Countdown.ico</ApplicationIcon>

    <!-- Economia de processamento e memória (o app fica aberto o tempo todo):
         coleta de lixo sem thread extra em segundo plano, sem otimização guiada em tempo real
         e código já compilado para Windows x64 (ReadyToRun), sem compilar ao abrir -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sons do relógio embutidos dentro do .exe (LogicalName = nome usado para achar o arquivo no código) -->
    <EmbeddedResource Include="Sounds\*.mp3" LogicalName="%(Filename)%(Extension)" />
    <!-- Ícone também embutido como recurso, para a janela usar direto (sem depender do cache do Windows) -->
    <EmbeddedResource Include="Countdown.ico" LogicalName="Countdown.ico" />
  </ItemGroup>

</Project>
